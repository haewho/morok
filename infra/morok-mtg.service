[Unit]
Description=MOROK MTProxy node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=morok-proxy
Group=morok-proxy
ExecStart=/usr/local/bin/morok-mtg run /etc/morok/mtg.toml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
